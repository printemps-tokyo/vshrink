{
  "name": "@printemps-tokyo/vshrink",
  "version": "0.3.0",
  "description": "ffmpeg helpers to shrink, convert, concatenate, GIF-ify, and (un)burn subtitles in videos. Zero-dependency CLI.",
  "type": "module",
  "license": "MIT",
  "author": "printemps.tokyo <develop@printemps.tokyo>",
  "homepage": "https://github.com/printemps-tokyo/vshrink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/printemps-tokyo/vshrink.git"
  },
  "bugs": {
    "url": "https://github.com/printemps-tokyo/vshrink/issues"
  },
  "keywords": [
    "ffmpeg",
    "video",
    "compress",
    "cli",
    "transcode",
    "gif",
    "subtitles"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vshrink": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
